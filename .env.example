# Copy to .env to change these. Without a .env the app still runs locally with these defaults.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/dailyweb
NODE_ENV=development

# Signs the session cookie. Leave empty for local runs: a random secret is generated
# into .session-secret (ignored by Git). Required in production.
SESSION_SECRET=

# Optional: lets POST /api/auth/register create a staff account without logging in, by sending
# this value in the X-Admin-Key header. Leave empty to disable (a logged-in Editor can always create accounts).
ADMIN_SETUP_KEY=
